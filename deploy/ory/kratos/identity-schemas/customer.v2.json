{
  "$id": "https://schemas.go-ory-auth-example.local/customer.v2.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Customer (v2)",
  "description": "ADR-0013: traits hold only the pseudonymous login identifier '<base32 HMAC>@login.invalid'. The email or phone number is encrypted in identity-service (POST /v1/auth/identifiers resolves it); the real name is encrypted personal info.",
  "type": "object",
  "properties": {
    "traits": {
      "type": "object",
      "properties": {
        "login_id": {
          "type": "string",
          "format": "email",
          "pattern": "^[a-z2-7]{52}@login\\.invalid$",
          "maxLength": 66,
          "title": "Login",
          "ory.sh/kratos": {
            "credentials": {
              "password": {
                "identifier": true
              }
            },
            "verification": {
              "via": "email"
            },
            "recovery": {
              "via": "email"
            }
          }
        }
      },
      "required": [
        "login_id"
      ],
      "additionalProperties": false
    }
  }
}
