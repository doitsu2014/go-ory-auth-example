{
  "$id": "https://schemas.go-ory-auth-example.local/customer.v1.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Customer (v1.1)",
  "description": "v1.1: traits hold only the login email. The real name is encrypted personal info in identity-service (PUT /v1/me/personal-info).",
  "type": "object",
  "properties": {
    "traits": {
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 320,
          "title": "Email",
          "ory.sh/kratos": {
            "credentials": {
              "password": { "identifier": true }
            },
            "verification": { "via": "email" },
            "recovery": { "via": "email" }
          }
        }
      },
      "required": ["email"],
      "additionalProperties": false
    }
  }
}
