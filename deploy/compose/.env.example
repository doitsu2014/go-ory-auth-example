# Local development values only. Copy to .env (git-ignored): `make env`.
# Never reuse these anywhere else.
POSTGRES_PASSWORD=local-postgres-pw
KRATOS_DB_PASSWORD=local-kratos-pw
KETO_DB_PASSWORD=local-keto-pw
IDENTITY_MIGRATOR_DB_PASSWORD=local-identity-migrator-pw
IDENTITY_APP_DB_PASSWORD=local-identity-app-pw

# Kratos secrets (>= 32 chars; cipher must be exactly 32 chars).
KRATOS_SECRETS_COOKIE_VALUE=local-cookie-secret-0123456789abcdef
KRATOS_SECRETS_CIPHER_VALUE=local-cipher-secret-0123456789ab
KRATOS_SECRETS_DEFAULT_VALUE=local-default-secret-0123456789abcd

KRATOS_WEBHOOK_API_KEY=local-webhook-key-0123456789abcdef

# Where Kratos reaches identity-service webhooks.
# In compose: http://identity-service:8081. Service on host: http://host.docker.internal:8081
IDENTITY_WEBHOOK_BASE_URL=http://identity-service:8081

# Ory Hydra (machine-to-machine OAuth2). System secret >= 32 chars.
HYDRA_DB_PASSWORD=local-hydra-pw
HYDRA_SECRETS_SYSTEM=local-hydra-system-secret-0123456789ab

# HMAC key that tags service clients created by identity-service (base64, >= 32 bytes).
M2M_CLIENT_TAG_KEY=bG9jYWwtbTJtLXRhZy1rZXktMDEyMzQ1Njc4OWFiY2Q=
