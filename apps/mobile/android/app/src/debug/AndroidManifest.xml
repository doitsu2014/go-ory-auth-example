<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Debug/local only: cleartext HTTP to the compose stack on the host
         (10.0.2.2 from the emulator, localhost via adb reverse). The
         network security config takes precedence over the main manifest's
         usesCleartextTraffic="false" (API 24+). -->
    <application android:networkSecurityConfig="@xml/network_security_config"/>
</manifest>
